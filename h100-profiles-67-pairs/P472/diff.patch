+@triton.jit
+def ln_kernel(x_ptr, y_ptr, w_ptr, b_ptr, mean_ptr, rstd_ptr, L, eps, BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    chunk = tl.program_id(1)
+    base = x_ptr + row * L
+    offs = chunk * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < L
+    
+    # Load input with masking
+    x = tl.load(base + offs, mask=mask, other=0.0)
+    
+    # Shared memory for reduction
+    mean = tl.load(mean_ptr + row, mask=True)
+    rstd = tl.load(rstd_ptr + row, mask=True)
+    
+    # Load weights and biases
+    w = tl.load(w_ptr + offs, mask=mask, other=1.0)
+    b = tl.load(b_ptr + offs, mask=mask, other=0.0)
+    
+    # Apply normalization
+    y = (x - mean) * rstd * w + b
+    tl.store(y_ptr + row * L + offs, y, mask=mask)
 
 
